# Copy this file to .env (same folder) and fill in your values.
# .env is gitignored — it never gets committed. This .example file is the
# committed template and contains no real secrets.

# --- Gemini (required for real runs; --dry-run needs nothing) --------------
# Free key, no card: aistudio.google.com -> Get API key.
GEMINI_API_KEY=paste-your-key-here

# --- Email (--send only) ---------------------------------------------------
# The brief is sent through Section 8's frozen send_email(), and that module
# loads its OWN .env from 8_send_email/project/ at import time.
# So you have two options:
#   (A) Fill in Section 8's .env (you already did, in Section 8) and leave
#       these blank here — the import picks them up from there. Simplest.
#   (B) Or duplicate them here so this project is self-contained.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com
