# ---------------------------------------------------------------------------
# Section 10 — email configuration TEMPLATE.
#
#   1. Copy this file:      cp .env.example .env
#   2. Fill in your values below.
#   3. NEVER commit .env — only this .env.example. (.env holds a real password.)
#
# The code loads these with python-dotenv. Nothing secret ever lives in a .py
# file, so you can share your scripts freely.
# ---------------------------------------------------------------------------

# --- Your mail server ---
# Gmail:     smtp.gmail.com    port 587
# Outlook:   smtp.office365.com port 587
# Fastmail:  smtp.fastmail.com port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Your login ---
# The full email address you sign in with.
SMTP_USERNAME=jacksontesting@gmail.com

# IMPORTANT (Gmail): this is NOT your normal Google password.
# It is a 16-character "App Password". To get one:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an App Password:       myaccount.google.com/apppasswords
#   3. Paste the 16 characters here (spaces are fine; keep or remove them).
# Other providers: use an app-specific password if they offer one.
SMTP_PASSWORD=your-16-char-app-password

# --- Addresses ---
# The From: address — usually the same address you log in with.
EMAIL_FROM=jacksontesting@gmail.com

# Where the report goes. For the send-to-self test, make this your OWN address.
EMAIL_TO=jacksontesting@gmail.com
