# Copy this file to .env and fill in real values. Never commit the real .env.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_account@gmail.com
# For Gmail, use an App Password, not your normal account password.
SMTP_PASSWORD=your_app_password

EMAIL_FROM=your_account@gmail.com
# Comma-separated if sending to more than one address.
#Getting one:
#1.Enable 2-Step Verification on your Google account (required — the option doesn't appear otherwise)
#2.Go to your Google Account → Security → App passwords
#3.Name it something like "sales report script"
#4.Copy the 16 characters into SMTP_PASSWORD
#Steps to revoke it: 
#1.Go to myaccount.google.com → Security
#2.Find App passwords (under "How you sign in to Google" — you may need to search "app passwords" in the settings search bar, since Google keeps moving it)
#3.Re-authenticate when prompted
#4.You'll see a list of every app password with the name you gave it and when it was last used
#5.Click the trash icon / Remove next to the one you want gone


EMAIL_TO=you@example.com

# Optional overrides — defaults shown.
# CSV_FOLDER=sample_data
# OUTPUT_PATH=monthly_report.xlsx
# EMAIL_SUBJECT=Weekly Sales Report
